pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is ready!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Python application...'
                sh 'python3 app.py'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'python3 -m compileall app.py'
            }
        }
    }
}