
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code is ready!'
            }
        }

        stage('Build') {
            steps {
                dir('testing-python') {
                    echo 'Building Python application...'
                    sh 'python3 sentry_config.py'
                }
            }
        }

        stage('Test') {
            steps {
                dir('testing-python') {
                    echo 'Running syntax check...'
                    sh 'python3 -m compileall sentry_config.py'
                }
            }
        }
    }
}
